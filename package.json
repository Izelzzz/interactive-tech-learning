{
  "name": "interactive-tech-learning",
  "private": true,
  "description": "Interactive tech lessons: static HTML pages in demos/",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check:i18n": "python3 tools/i18n.py check",
    "test:static": "node tests/static.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "test": "npm run check:i18n && npm run build && npm run test:static && npm run test:smoke"
  },
  "devDependencies": {
    "@astrojs/mdx": "8.0.3",
    "astro": "7.3.8",
    "playwright": "1.64.1",
    "wrangler": "4.148.0"
  }
}
