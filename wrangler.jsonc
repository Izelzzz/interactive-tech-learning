{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "interactive-tech-learning",
  "compatibility_date": "2026-10-06",
  // Astro builds the site into dist/: the hand-written lessons from demos/ plus the MDX pages.
  // wrangler deploy and wrangler preview run the build first.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist"
  },
  // Same as the blog: a workers.dev Preview URL for every non-production branch.
  "preview_urls": true,
  "previews": {}
}
